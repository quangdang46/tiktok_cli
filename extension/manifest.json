{
  "manifest_version": 3,
  "name": "TikTok Summarizer",
  "version": "0.2.0",
  "description": "Floating bubble on TikTok: record the current video's audio, transcribe it, and show an AI summary.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
